# what this site is — in git; secrets and this machine's values go to .env, which is read after this file
SITE_NAME=ODS Labs
DB_NAME=ods
SITE_URL=http://127.0.0.1:5035
GUIDE_DIR=../data/guide
GUIDE_READERS=active
# guide pages for the teacher only, slug prefixes: the old labs' archive (T357)
GUIDE_STAFF=old-
SESSION_COOKIE=ods_session
# labs in the course: the columns of «Строки» and «Звід»
LABS=5
# labs come as notebook files, not GitHub repositories: no GitHub in the morning digest (T353 Q2)
REPOS=false
# how open each lab is to students, lab 1 first: hidden · telegram (read it, hand in to the teacher in Telegram) · site (hand in here);
# the teacher's click on /labs goes over this (T368)
LAB_GATES=telegram,telegram,site,hidden,hidden
# «Мій тиждень»: the grid students mark their week on — hours from-to, days from Monday
WEEK_HOURS=15-23
WEEK_DAYS=6
