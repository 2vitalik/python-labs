# copy to .env and fill in; what the site is (name, db, folders) — site.env, in git, read before this file
MONGO_URI=mongodb://localhost:27017
DB_NAME=ods

# from Google Cloud console: the OAuth client needs this site's redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# comma-separated; these emails get admin status and bypass the nure.ua filter
ADMIN_EMAILS=

# dev login without Google (local only); empty = disabled
FAKE_USER_EMAIL=

# telegram bot username (without @) for the profile link button; empty = button hidden
TG_BOT_NAME=

# from BotFather; needed only to run the bot (`uv run python -m bot`)
TG_BOT_TOKEN=

# AI agents that work with the site through bin/lesson, bin/zoom, bin/due, bin/guide (-t ods): name:token, comma-separated;
# the name is the author in history; a token — `openssl rand -hex 32`; empty = no way in for agents
AGENT_TOKENS=

# public site address for links in bot messages (dev default: http://127.0.0.1:5035)
SITE_URL=https://ods.labs.in.ua

# Zoom Server-to-Server OAuth app (T221): attendance of a lesson from its meeting via bin/zoom or «Оновити із Zoom»
# on the lesson's page; the scopes — in app/api/.env.example. Empty = the button says Zoom is not set up
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
