# what this site is — in git; secrets and this machine's values go to .env, which is read after this file
SITE_NAME=Python Labs
DB_NAME=python_labs
SITE_URL=http://127.0.0.1:5030
GUIDE_DIR=../../data/guide
# the whole guide is open to anyone, a guest too (T214); drafts in the text stay the admin's
GUIDE_READERS=all
# «Мій тиждень»: the grid students mark their week on — hours from-to, days from Monday
WEEK_HOURS=15-23
WEEK_DAYS=6
# «Моя гра» for students: simple — header, entities and windows only; full — everything (T270)
GAME_DEPTH=simple
# «Описати словами» — the AI assistant in «Моя гра» (T291 §14): off · admin — the teacher only · students; the key is in .env
AI_DESCRIBE=admin
# the model: Opus gave the cleanest proposals on the etalons (T292); Sonnet is half the price, Haiku — a twentieth
AI_MODEL=claude-opus-5-5
# a reward on a defense's remark (T329): off · draft — the teacher sees it, the wallet does not count it · open — students too
REMARK_COINS=draft
