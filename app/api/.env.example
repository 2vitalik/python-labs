# copy to .env and fill in; what the site is (name, default db, guide folder) — site.env, in git, read before this file
MONGO_URI=mongodb://localhost:27017
DB_NAME=python_labs

# from Google Cloud console (T43)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# comma-separated; these emails get admin status and bypass the nure.ua filter
ADMIN_EMAILS=

# dev login without Google (local only); empty = disabled
FAKE_USER_EMAIL=

# telegram bot username (without @) for the profile link button; empty = button hidden
TG_BOT_NAME=python_nure_bot

# from BotFather; needed only to run the bot (`uv run python -m bot`)
TG_BOT_TOKEN=

# AI agents that edit the guide and the catalog via bin/guide, bin/catalog (T153, T155): name:token, comma-separated;
# the name is the author in history;
# a token — `openssl rand -hex 32`; empty = no way in for agents
AGENT_TOKENS=

# public site address for links in bot messages (dev default: http://127.0.0.1:5030)
SITE_URL=https://python.labs.in.ua

# Zoom Server-to-Server OAuth app (Marketplace → Develop → Build App; T221): attendance of a lesson from its meeting via bin/zoom
# or «Оновити із Zoom» on the lesson's page. Scopes: meeting:read:list_past_participants:admin, meeting:read:past_meeting:admin,
# cloud_recording:read:list_recording_files:admin (for --sources). Empty = the button says Zoom is not set up
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
