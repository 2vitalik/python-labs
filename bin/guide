#!/usr/bin/env python3
"""bin/guide — guide pages of the site as local files, the way in for AI agents (T153, T155).

  bin/guide [-t dev] ls
  bin/guide [-t dev] pull [slug…]                           no slug = every page
  bin/guide [-t dev] push <slug> -m "що змінив" [-s "Розділ"]
  bin/guide [-t dev] snap [--to <dir>]                      every page → data/guide/, for git; -t other than prod needs --to
  bin/guide [-t dev] dump [--to <file>]                     every page with its history of edits → one JSON, for a mirror

A page is .site/<target>/guide/<slug>.md: `# title`, a blank line, the body. No -t = prod, and a push there ends
with a snap. The token's name on the server is who the site's history shows.
A dump makes another site's guide a mirror of this one: in that site's folder, `python -m core.guide_mirror apply <file>`."""
import argparse
import json
import sys
from pathlib import Path

from siteapi import HOME, ROOT, SNAP, call, file, keep, pull, snap, taken

SNAP_DIR = ROOT / "data" / "guide"  # the prod site's pages in git; another site's texts must never land here
DRAFT = "changes-draft"  # the admin's page of unpublished change notes: not in the list, part of a mirror


def text(page: dict) -> str:
    return f"# {page['title']}\n\n{page['body']}\n"


def snapshot(to: str, folder: Path):
    pages = [call(to, "GET", f"/guide/{g['slug']}") for g in call(to, "GET", "/guide")]
    snap(folder, {f"{p['slug']}.md": text(p) for p in pages})


def dump(to: str, path: Path):
    slugs = [g["slug"] for g in call(to, "GET", "/guide")] + [DRAFT]
    pages = [call(to, "GET", f"/guide/{s}") for s in slugs]
    history = {s: call(to, "GET", f"/guide/history?slug={s}") for s in slugs}  # 200 edits a page at most — the API's cap
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"from": to, "pages": pages, "history": history}, ensure_ascii=False, indent=1))
    print(f"дамп: {len(pages)} сторінок, {sum(map(len, history.values()))} правок → {path}")


def push(to: str, slug: str, note: str, section: str):
    was, path = taken(to, "guide", slug), file(to, "guide", slug)
    if not was or not path.exists():
        sys.exit(f"спершу pull {slug}")
    title, _, body = path.read_text().partition("\n")
    page = call(to, "PUT", f"/guide/{slug}", {"title": title.lstrip("# ").strip(), "body": body.strip(), "rev": was["rev"],
                                              "note": note, "section": section})
    keep(to, "guide", page, text(page))
    print(f"{slug}: rev {was['rev']} → {page['rev']} · {page['updated_by']}" if page["rev"] != was["rev"] else f"{slug}: без змін")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-t", "--target", default=SNAP)
    parser.add_argument("cmd", choices=["ls", "pull", "push", "snap", "dump"])
    parser.add_argument("slugs", nargs="*")
    parser.add_argument("-m", "--note", default="")
    parser.add_argument("-s", "--section", default="")
    parser.add_argument("--to", type=Path)
    a = parser.parse_args()
    if a.cmd == "ls":
        for g in call(a.target, "GET", "/guide"):
            print(f"{g['slug']:<16} {g['updated'][:10]}  {g['title']}")
    elif a.cmd == "pull":
        for slug in a.slugs or [g["slug"] for g in call(a.target, "GET", "/guide")]:
            page = call(a.target, "GET", f"/guide/{slug}")
            print(f"{pull(a.target, 'guide', page, text).relative_to(ROOT)} · rev {page['rev']}")
    elif a.cmd == "snap":
        if a.target != SNAP and not a.to:
            sys.exit(f"snap -t {a.target}: вкажи --to — data/guide/ належить {SNAP}")
        snapshot(a.target, a.to or SNAP_DIR)
    elif a.cmd == "dump":
        dump(a.target, a.to or HOME / a.target / "guide-dump.json")
    elif len(a.slugs) != 1:
        sys.exit("push — одна сторінка за раз")
    else:
        push(a.target, a.slugs[0], a.note, a.section)
        if a.target == SNAP:
            snapshot(a.target, a.to or SNAP_DIR)


if __name__ == "__main__":
    main()
