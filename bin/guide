#!/usr/bin/env python3
"""bin/guide — guide pages of the site as local files, the way in for AI agents (T153, T155).

  bin/guide [-t dev] ls
  bin/guide [-t dev] pull [slug…]                           no slug = every page
  bin/guide [-t dev] push <slug> -m "що змінив" [-s "Розділ"]
  bin/guide [-t dev] snap [--to <dir>]                      every page → data/guide/, for git

A page is .site/<target>/guide/<slug>.md: `# title`, a blank line, the body. No -t = prod, and a push there ends
with a snap. The token's name on the server is who the site's history shows."""
import argparse
import sys
from pathlib import Path

from siteapi import ROOT, SNAP, call, file, keep, pull, snap, taken


def text(page: dict) -> str:
    return f"# {page['title']}\n\n{page['body']}\n"


def snapshot(to: str, folder: Path):
    pages = [call(to, "GET", f"/guide/{g['slug']}") for g in call(to, "GET", "/guide")]
    snap(folder, {f"{p['slug']}.md": text(p) for p in pages})


def push(to: str, slug: str, note: str, section: str):
    was, path = taken(to, "guide", slug), file(to, "guide", slug)
    if not was or not path.exists():
        sys.exit(f"спершу pull {slug}")
    title, _, body = path.read_text().partition("\n")
    page = call(to, "PUT", f"/guide/{slug}", {"title": title.lstrip("# ").strip(), "body": body.strip(), "rev": was["rev"],
                                              "note": note, "section": section})
    keep(to, "guide", page, text(page))
    print(f"{slug}: rev {was['rev']} → {page['rev']} · {page['updated_by']}" if page["rev"] != was["rev"] else f"{slug}: без змін")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-t", "--target", default=SNAP)
    parser.add_argument("cmd", choices=["ls", "pull", "push", "snap"])
    parser.add_argument("slugs", nargs="*")
    parser.add_argument("-m", "--note", default="")
    parser.add_argument("-s", "--section", default="")
    parser.add_argument("--to", type=Path, default=ROOT / "data" / "guide")
    a = parser.parse_args()
    if a.cmd == "ls":
        for g in call(a.target, "GET", "/guide"):
            print(f"{g['slug']:<16} {g['updated'][:10]}  {g['title']}")
    elif a.cmd == "pull":
        for slug in a.slugs or [g["slug"] for g in call(a.target, "GET", "/guide")]:
            page = call(a.target, "GET", f"/guide/{slug}")
            print(f"{pull(a.target, 'guide', page, text).relative_to(ROOT)} · rev {page['rev']}")
    elif a.cmd == "snap":
        snapshot(a.target, a.to)
    elif len(a.slugs) != 1:
        sys.exit("push — одна сторінка за раз")
    else:
        push(a.target, a.slugs[0], a.note, a.section)
        if a.target == SNAP:
            snapshot(a.target, a.to)


if __name__ == "__main__":
    main()
