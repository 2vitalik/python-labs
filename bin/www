#!/usr/bin/env bash
# bin/www [commit] — build the SPA from a commit's tree (default HEAD)
#   in a temp dir; commit dist/ as a parentless commit (subject = sha).
# Next: force-push that commit as branch www.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
sha=$(git rev-parse --verify "${1:-HEAD}^{commit}")
git_dir=$(git rev-parse --absolute-git-dir)

say() { echo "www: $*"; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git archive "$sha:app/vue" | tar -x -C "$tmp"
ln -s "$PWD/app/vue/node_modules" "$tmp/node_modules"

say "build ${sha:0:7} in $tmp"
(cd "$tmp" && npm run build)

(cd "$tmp/dist" && GIT_INDEX_FILE=$tmp/index \
  git --git-dir="$git_dir" --work-tree=. add -A)
tree=$(GIT_INDEX_FILE=$tmp/index git write-tree)
commit=$(git commit-tree "$tree" -m "$sha")

say "commit ${commit:0:7} (tree ${tree:0:7}) = dist of ${sha:0:7}"
git show --stat --format='%h %s · parents: [%p]' "$commit"
