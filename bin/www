#!/usr/bin/env bash
# bin/www [commit] — build the SPA from a commit's tree (default HEAD):
#   app/vue with the platform it imports, core/ui;
#   in a temp dir, commit dist/ as a parentless commit (subject = sha)
#   and force-push it as branch www: the branch is always one commit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
sha=$(git rev-parse --verify "${1:-HEAD}^{commit}")
git_dir=$(git rev-parse --absolute-git-dir)

say() { echo "www: $*"; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

paths=(app/vue)
git cat-file -e "$sha:core/ui" 2>/dev/null && paths+=(core/ui)  # a commit older than core/ has none
git archive "$sha" "${paths[@]}" | tar -x -C "$tmp"
ln -s "$PWD/app/vue/node_modules" "$tmp/app/vue/node_modules"

say "build ${sha:0:7} in $tmp"
(cd "$tmp/app/vue" && npm run build)

(cd "$tmp/app/vue/dist" && GIT_INDEX_FILE=$tmp/index \
  git --git-dir="$git_dir" --work-tree=. add -A)

tree=$(GIT_INDEX_FILE=$tmp/index git write-tree)
commit=$(git commit-tree "$tree" -m "$sha")

say "commit ${commit:0:7} (tree ${tree:0:7}) = dist of ${sha:0:7}"
git show --stat --format='%h %s · parents: [%p]' "$commit"

git push -f origin "$commit:refs/heads/www"
say "origin/www ← ${commit:0:7}"
