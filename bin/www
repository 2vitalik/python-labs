#!/usr/bin/env bash
# bin/www <site> [commit] — build a site's SPA from a commit's tree (default HEAD):
#   python — app/vue → branch www · ods — sites/ods/vue → branch www-ods;
#   each with the platform it imports, core/ui;
#   in a temp dir, commit dist/ as a parentless commit (subject = sha)
#   and force-push it as the site's branch: the branch is always one commit.
set -euo pipefail

case "${1:-}" in
  python) vue=app/vue branch=www ;;
  ods) vue=sites/ods/vue branch=www-ods ;;
  *) echo "usage: bin/www python|ods [commit]" >&2; exit 2 ;;
esac

cd "$(git rev-parse --show-toplevel)"
sha=$(git rev-parse --verify "${2:-HEAD}^{commit}")
git_dir=$(git rev-parse --absolute-git-dir)

say() { echo "$branch: $*"; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

paths=("$vue")
git cat-file -e "$sha:core/ui" 2>/dev/null && paths+=(core/ui)  # a commit older than core/ has none
git archive "$sha" "${paths[@]}" | tar -x -C "$tmp"
ln -s "$PWD/$vue/node_modules" "$tmp/$vue/node_modules"

say "build ${sha:0:7} in $tmp"
(cd "$tmp/$vue" && npm run build)

(cd "$tmp/$vue/dist" && GIT_INDEX_FILE=$tmp/index \
  git --git-dir="$git_dir" --work-tree=. add -A)

tree=$(GIT_INDEX_FILE=$tmp/index git write-tree)
commit=$(git commit-tree "$tree" -m "$sha")

say "commit ${commit:0:7} (tree ${tree:0:7}) = dist of ${sha:0:7}"
git show --stat --format='%h %s · parents: [%p]' "$commit"

git push -f origin "$commit:refs/heads/$branch"
say "origin/$branch ← ${commit:0:7}"
